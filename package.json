{
  "name": "cognirogue",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "把间隔复习做成一场 Roguelike 牌局",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "vite",
    "serve": "node tools/serve.mjs",
    "build": "npm run verify && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && node tools/deps.mjs && node tools/invariants.mjs && uv run --cache-dir .cache/uv --frozen python -m py_compile server/app.py && uv run --cache-dir .cache/uv --frozen python -m unittest server.test_app && node --check tools/service.mjs && node --check tools/serve.mjs && node --check tools/dev.mjs",
    "sim": "esbuild tools/sim.ts --bundle --platform=node --format=esm --outfile=.cache/sim.mjs --log-level=warning && node .cache/sim.mjs",
    "smoke": "node tools/smoke.mjs",
    "shots": "node tools/shots.mjs",
    "stage": "esbuild tools/stagecheck.ts --bundle --platform=node --format=esm --outfile=.cache/stagecheck.mjs --log-level=warning && node .cache/stagecheck.mjs",
    "cards": "esbuild tools/cards.ts --bundle --platform=node --format=esm --outfile=.cache/cards.mjs --log-level=warning && node .cache/cards.mjs",
    "coverage": "esbuild tools/coverage.ts --bundle --platform=node --format=esm --outfile=.cache/coverage.mjs --log-level=warning && node .cache/coverage.mjs",
    "gencheck": "esbuild tools/gen/selftest.ts --bundle --platform=node --format=esm --outfile=.cache/gencheck.mjs --log-level=warning && node .cache/gencheck.mjs",
    "verify": "npm run check && npm run cards && npm run coverage && npm run docs && npm run gencheck && npm run stage",
    "words": "node tools/words.mjs",
    "sources": "node tools/sources.mjs",
    "gen": "esbuild tools/gen/main.ts --bundle --platform=node --format=esm --outfile=.cache/gen.mjs --log-level=warning && node .cache/gen.mjs",
    "plan": "esbuild tools/gen/plancli.ts --bundle --platform=node --format=esm --outfile=.cache/plan.mjs --log-level=warning && node .cache/plan.mjs",
    "pool:build": "esbuild ./tools/runpool.ts --bundle --platform=node --format=esm --outfile=.cache/runpool.mjs --log-level=warning",
    "service:build": "npm run pool:build && esbuild tools/gen/main.ts --bundle --platform=node --format=esm --outfile=.cache/gen.mjs --log-level=warning && esbuild tools/gen/plancli.ts --bundle --platform=node --format=esm --outfile=.cache/plan.mjs --log-level=warning",
    "docs": "esbuild tools/docs.ts --bundle --platform=node --format=esm --outfile=.cache/docs.mjs --log-level=warning && node .cache/docs.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
